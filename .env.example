# ==============================================================================
# ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# Salin file ini menjadi ".env" dan isi dengan value yang sesuai.
#
# ATURAN PENTING:
# - Variable dengan prefix "PUBLIC_" bisa diakses di browser (client-side)
# - Variable TANPA prefix "PUBLIC_" hanya bisa diakses di server (API endpoint)
# - JANGAN commit file .env ke Git! (sudah ada di .gitignore)
# ==============================================================================

# --- URL Website ---
# URL production website kamu (untuk sitemap, canonical URL, dll)
SITE_URL=https://example.com

# --- Meta / Facebook Ads ---
# Pixel ID: Dapatkan dari Meta Events Manager > Data Sources > Pixel
PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID_HERE

# Access Token: Dapatkan dari Meta Events Manager > Settings > Conversions API
# ⚠️ INI RAHASIA! Jangan expose ke client-side (tanpa PUBLIC_ prefix)
META_CAPI_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# Test Event Code: Untuk testing di Events Manager > Test Events
# Kosongkan atau hapus setelah selesai testing
META_TEST_EVENT_CODE=

# --- WhatsApp ---
# Nomor WhatsApp untuk CTA button (format internasional tanpa +)
PUBLIC_WHATSAPP_NUMBER=6281234567890

# Pesan default saat klik WhatsApp CTA
PUBLIC_WHATSAPP_MESSAGE=Halo, saya tertarik dengan produk Anda!
