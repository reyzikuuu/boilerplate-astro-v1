---
// =============================================================================
// PRODUCT CARD — Card Produk untuk Halaman Listing Katalog
// =============================================================================
import type { Product } from '@data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<a href={`/katalog/${product.slug}`} class="product-card group" id={`card-${product.slug}`}>
  <!-- Gambar Produk -->
  <div class="card-image-wrapper">
    <img
      src={product.images[0]}
      alt={product.name}
      loading="lazy"
      decoding="async"
      width="600"
      height="800"
      class="card-image"
    />
    <!-- Badge jumlah bahan -->
    <span class="card-badge">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
      </svg>
      {product.materials.length} Bahan
    </span>
    <!-- Hover overlay -->
    <div class="card-overlay">
      <span class="card-overlay-text">
        Lihat Detail
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Info Produk -->
  <div class="card-info">
    <h3 class="card-name">{product.name}</h3>
    <p class="card-desc">{product.shortDescription}</p>
    <span class="card-cta">
      Lihat Detail
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </span>
  </div>
</a>

<style>
  /* ================================================================
     CARD
     ================================================================ */
  .product-card {
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.3s ease;
    cursor: pointer;
  }
  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3),
                0 0 30px rgba(120, 119, 198, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  /* ================================================================
     IMAGE
     ================================================================ */
  .card-image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #111;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .product-card:hover .card-image {
    transform: scale(1.06);
  }

  /* Badge bahan */
  .card-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-gold);
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.2);
    z-index: 2;
  }

  /* Hover overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }
  .product-card:hover .card-overlay {
    opacity: 1;
  }

  .card-overlay-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transform: translateY(8px);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .product-card:hover .card-overlay-text {
    transform: translateY(0);
  }

  /* ================================================================
     INFO
     ================================================================ */
  .card-info {
    padding: 1rem 1.15rem 1.25rem;
  }

  .card-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  @media (min-width: 1024px) {
    .card-name {
      font-size: 1.05rem;
    }
  }

  .card-desc {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.55;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .card-desc {
      font-size: 0.78rem;
    }
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-gold);
    transition: gap 0.3s ease;
  }
  .product-card:hover .card-cta {
    gap: 0.5rem;
  }
  @media (min-width: 1024px) {
    .card-cta {
      font-size: 0.78rem;
    }
  }
</style>
