---
// =============================================================================
// PRODUCT GALLERY — Galeri Gambar Produk (Detail Page)
// =============================================================================
// Menampilkan gambar utama besar + strip thumbnail di bawah.
// Klik thumbnail → gambar utama berubah (client-side JS).
// =============================================================================

interface Props {
  images: string[];
  productName: string;
}

const { images, productName } = Astro.props;
---

<div class="gallery-container" id="product-gallery">
  <!-- Gambar Utama -->
  <div class="gallery-main">
    <img
      id="gallery-main-img"
      src={images[0]}
      alt={`${productName} — tampilan utama`}
      width="600"
      height="800"
      class="gallery-main-image"
    />
  </div>

  <!-- Thumbnail Strip -->
  <div class="gallery-thumbs" id="gallery-thumbs">
    {images.map((img, i) => (
      <button
        class={`gallery-thumb ${i === 0 ? 'gallery-thumb-active' : ''}`}
        data-index={i}
        data-src={img}
        aria-label={`Lihat gambar ${i + 1}`}
        type="button"
      >
        <img
          src={img}
          alt={`${productName} — gambar ${i + 1}`}
          loading="lazy"
          decoding="async"
          width="120"
          height="160"
        />
      </button>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
    const thumbsContainer = document.getElementById('gallery-thumbs');
    
    if (!mainImg || !thumbsContainer) return;

    const thumbs = thumbsContainer.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        if (!src || mainImg.src.endsWith(src)) return;

        // Update gambar utama dengan fade transition
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = src;
          mainImg.style.opacity = '1';
        }, 200);

        // Update active state pada thumbnail
        thumbs.forEach((t) => t.classList.remove('gallery-thumb-active'));
        thumb.classList.add('gallery-thumb-active');
      });
    });
  });
</script>

<style>
  /* ================================================================
     CONTAINER
     ================================================================ */
  .gallery-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ================================================================
     MAIN IMAGE
     ================================================================ */
  .gallery-main {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 1rem;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gallery-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.25s ease;
  }

  /* ================================================================
     THUMBNAILS
     ================================================================ */
  .gallery-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    /* Hide scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .gallery-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery-thumb {
    flex-shrink: 0;
    width: 4rem;
    height: 5.3rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 2px solid transparent;
    background: #111;
    cursor: pointer;
    transition: border-color 0.25s ease, opacity 0.25s ease;
    opacity: 0.5;
    padding: 0;
  }
  .gallery-thumb:hover {
    opacity: 0.8;
  }

  .gallery-thumb-active {
    border-color: var(--color-gold);
    opacity: 1;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .gallery-thumb {
      width: 5rem;
      height: 6.6rem;
    }
  }
</style>
