---
// =============================================================================
// MATERIAL SELECTOR — Pemilih Bahan Kain
// =============================================================================
// Grid 6 item bahan. Klik bahan → highlight gold border.
// =============================================================================
import type { Material } from '@data/products';

interface Props {
  materials: Material[];
}

const { materials } = Astro.props;
---

<div class="materials-section">
  <div class="materials-header">
    <svg class="materials-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
    </svg>
    <h2 class="materials-title">Pilihan Bahan</h2>
    <span class="materials-count">{materials.length} varian</span>
  </div>

  <div class="materials-grid" id="materials-grid">
    {materials.map((mat, i) => (
      <button
        class={`material-card ${i === 0 ? 'material-active' : ''}`}
        data-index={i}
        type="button"
        aria-label={`Pilih bahan ${mat.name}`}
      >
        <div class="material-image-wrapper">
          <img
            src={mat.image}
            alt={mat.name}
            loading="lazy"
            decoding="async"
            width="200"
            height="200"
            class="material-image"
          />
        </div>
        <div class="material-info">
          <p class="material-name">{mat.name}</p>
          <p class="material-desc">{mat.description}</p>
        </div>
      </button>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('materials-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll<HTMLButtonElement>('.material-card');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((c) => c.classList.remove('material-active'));
        card.classList.add('material-active');
      });
    });
  });
</script>

<style>
  /* ================================================================
     HEADER
     ================================================================ */
  .materials-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .materials-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .materials-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    .materials-title {
      font-size: 1.15rem;
    }
  }

  .materials-count {
    margin-left: auto;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-gold);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 0.02em;
  }

  /* ================================================================
     GRID
     ================================================================ */
  .materials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .materials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ================================================================
     CARD
     ================================================================ */
  .material-card {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1.5px solid rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: border-color 0.3s ease,
                background 0.3s ease,
                transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    text-align: left;
    width: 100%;
  }
  .material-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Active state — gold highlight */
  .material-active {
    border-color: rgba(245, 158, 11, 0.5) !important;
    background: rgba(245, 158, 11, 0.06) !important;
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.08);
  }

  /* ================================================================
     MATERIAL IMAGE
     ================================================================ */
  .material-image-wrapper {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .material-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .material-image-wrapper {
      width: 4rem;
      height: 4rem;
    }
  }

  /* ================================================================
     MATERIAL INFO
     ================================================================ */
  .material-info {
    flex: 1;
    min-width: 0;
  }

  .material-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.2rem;
    line-height: 1.3;
  }
  @media (min-width: 1024px) {
    .material-name {
      font-size: 0.8rem;
    }
  }

  .material-desc {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .material-desc {
      font-size: 0.68rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
