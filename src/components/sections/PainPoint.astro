---
// =============================================================================
// PAIN POINT SECTION — Problem → Bradwear as Solution
// =============================================================================
import { getWhatsAppUrl } from "@data/siteConfig";

const painPoints = [
  {
    icon: "/pain-icon/pain-icon-1.svg",
    text: "Pas datang tidak sesuai gambar iklan",
  },
  {
    icon: "/pain-icon/pain-icon-2.svg",
    text: "Bahan tipis, bordiran amburadul tidak presisi",
  },
  {
    icon: "/pain-icon/pain-icon-3.svg",
    text: "Panas dipakai di indoor dan outdoor",
  },
  {
    icon: "/pain-icon/pain-icon-4.svg",
    text: "Admin slow respon, deadline molor",
  },
];
---

<section class="pain-section" id="pain-section">
  <div class="container-page">

    {/* Header */}
    <div class="pain-header">
      <p class="pain-eyebrow">PENGALAMAN BURUK YANG SERING TERJADI</p>
      <h2 class="pain-headline">
        Pernah ngalamin bikin seragam dengan harga
        <span class="highlight-cheap">sangat murah</span> tapi:
      </h2>
    </div>

    {/* Pain Point Cards */}
    <div class="pain-grid">
      {painPoints.map((item, i) => (
        <div class="pain-card" style={`animation-delay: ${i * 0.1}s`}>
          <div class="pain-icon">
            <img src={item.icon} alt="" aria-hidden="true" loading="lazy" />
          </div>
          <p class="pain-text">{item.text}</p>
        </div>
      ))}
    </div>

    {/* Solution Block */}
    <div class="solution-block">
      <div class="solution-warning">
        <svg class="warning-icon" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
        </svg>
        <p class="warning-text">
          Jangan tergiur harga murah dengan iklan yang wah,<br/>
          <strong>mending yang pasti-pasti aja.</strong>
        </p>
      </div>

      <div class="solution-cta-block">
        <div class="solution-text-wrap">
          <p class="solution-brand">BRADWEAR</p>
          <p class="solution-desc">
            adalah solusi! Siap upgrade citra perusahaanmu dengan seragam profesional
            berkualitas tinggi — <em>kelas perusahaan multinasional.</em>
          </p>
        </div>
        <a
          href={getWhatsAppUrl("Halo Bradwear, saya ingin konsultasi kemeja custom.")}
          target="_blank"
          rel="noopener noreferrer"
          id="pain-whatsapp-cta"
          class="solution-btn group"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Konsultasi Gratis Sekarang</span>
          <div class="absolute top-0 -inset-full h-full w-1/2 z-5 block transform -skew-x-12 bg-linear-to-r from-transparent via-white/25 to-transparent group-hover:animate-[shine_0.6s_ease-out]"></div>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ==================================================================
     SECTION
     ================================================================== */
  .pain-section {
    position: relative;
    z-index: 10;
    padding: 4rem 0 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 1024px) {
    .pain-section {
      padding: 6rem 0 7rem;
    }
  }

  /* ==================================================================
     HEADER
     ================================================================== */
  .pain-header {
    text-align: center;
    margin-bottom: 2.5rem;
    max-width: 640px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .pain-header {
      margin-bottom: 3rem;
    }
  }

  .pain-eyebrow {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 0.75rem;
  }
  @media (min-width: 1024px) {
    .pain-eyebrow {
      font-size: 0.7rem;
    }
  }

  .pain-headline {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
    tracking: -0.02em;
  }
  @media (min-width: 640px) {
    .pain-headline {
      font-size: 1.65rem;
    }
  }
  @media (min-width: 1024px) {
    .pain-headline {
      font-size: 2rem;
    }
  }

  /* "sangat murah" highlight */
  .highlight-cheap {
    position: relative;
    display: inline-block;
    color: #fff;
    font-style: italic;
    font-weight: 800;
    padding: 0 0.25rem;
  }
  .highlight-cheap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.25) 0%, rgba(220, 38, 38, 0.15) 100%);
    border-radius: 0.25rem;
    border-bottom: 2px solid rgba(239, 68, 68, 0.6);
    z-index: -1;
  }

  /* ==================================================================
     PAIN GRID
     ================================================================== */
  .pain-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 640px;
    margin: 0 auto 2.5rem;
  }
  @media (min-width: 640px) {
    .pain-grid {
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .pain-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 900px;
      gap: 1rem;
      margin-bottom: 3.5rem;
    }
  }

  .pain-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 1.25rem 1rem;
    border-radius: 1rem;
    background: rgba(239, 68, 68, 0.04);
    border: 1px solid rgba(239, 68, 68, 0.12);
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .pain-card:hover {
    background: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.25);
  }
  @media (min-width: 1024px) {
    .pain-card {
      padding: 1.75rem 1.25rem;
    }
  }

  .pain-icon {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pain-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Converts black SVG fill → #ef4444 red */
    filter: invert(29%) sepia(96%) saturate(1679%) hue-rotate(337deg) brightness(101%) contrast(97%);
    opacity: 0.85;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  .pain-card:hover .pain-icon img {
    filter: invert(29%) sepia(96%) saturate(1679%) hue-rotate(337deg) brightness(115%) contrast(100%);
    opacity: 1;
  }

  .pain-text {
    font-size: 0.72rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.45;
  }
  @media (min-width: 640px) {
    .pain-text {
      font-size: 0.8rem;
    }
  }
  @media (min-width: 1024px) {
    .pain-text {
      font-size: 0.85rem;
    }
  }

  /* ==================================================================
     SOLUTION BLOCK
     ================================================================== */
  .solution-block {
    max-width: 760px;
    margin: 0 auto;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  .solution-warning {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    background: rgba(245, 158, 11, 0.07);
    border-bottom: 1px solid rgba(245, 158, 11, 0.15);
  }
  @media (min-width: 1024px) {
    .solution-warning {
      padding: 1.1rem 1.75rem;
    }
  }

  .warning-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: rgba(245, 158, 11, 0.9);
  }

  .warning-text {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
  }
  .warning-text strong {
    color: rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 1024px) {
    .warning-text {
      font-size: 0.85rem;
    }
  }

  .solution-cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .solution-cta-block {
      flex-direction: row;
      text-align: left;
      padding: 1.75rem 1.75rem;
      gap: 2rem;
    }
  }

  .solution-text-wrap {
    flex: 1;
  }

  .solution-brand {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.375rem;
  }
  @media (min-width: 1024px) {
    .solution-brand {
      font-size: 1.25rem;
    }
  }

  .solution-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }
  .solution-desc em {
    color: rgba(255, 255, 255, 0.8);
    font-style: normal;
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .solution-desc {
      font-size: 0.875rem;
    }
  }

  /* CTA Button */
  .solution-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    flex-shrink: 0;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 50%, #25d366 100%);
    background-size: 200% 200%;
    box-shadow: 0 0 20px rgba(37, 211, 102, 0.25), 0 4px 15px rgba(37, 211, 102, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-position 0.5s ease;
    cursor: pointer;
  }
  .solution-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 30px rgba(37, 211, 102, 0.4), 0 8px 25px rgba(37, 211, 102, 0.25);
    background-position: 100% 100%;
  }
  .solution-btn:active {
    transform: translateY(0) scale(0.98);
  }
</style>
