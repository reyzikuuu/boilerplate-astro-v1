---
// =============================================================================
// TRUSTED BY SECTION — Infinite Logo Loop
// =============================================================================
const logos = [
  "bgn.png",
  "bri.png",
  "bsi.png",
  "bumdes.png",
  "danantara.png",
  "kejaksaan.png",
  "kemenag.png",
  "kemendikbud.png",
  "kemenhub.png",
  "kemenhum.png",
  "kemenkes.png",
  "kemenkeu.png",
  "kemenprin.png",
  "kementrian%20indoneisa.png",
  "kementrian%20kependudukan.png",
  "kementrian-kebudayaan.png",
  "kemnaker.png",
  "komdigi.png",
  "polri.png",
  "pupr.png",
];
---

<section class="trusted-section">
  <div class="trusted-header">
    <p class="trusted-label">DIPERCAYA OLEH</p>
    <p class="trusted-sub">instansi pemerintahan, swasta dan multinasional</p>
  </div>

  {/* Stats Grid */}
  <div class="stats-grid">
    <div class="stat-item">
      <div class="stat-value">
        <span class="stat-number" id="stat-instansi">140</span><span
          class="stat-suffix">+</span
        >
      </div>
      <span class="stat-label">INSTANSI PERCAYA</span>
    </div>
    <div class="stat-item">
      <div class="stat-value">
        <span class="stat-number" id="stat-kemeja">10231</span>
      </div>
      <span class="stat-label">KEMEJA TERJUAL</span>
    </div>
  </div>

  <div class="marquee-wrapper">
    {/* Gradient fades */}
    <div class="marquee-fade marquee-fade-left"></div>
    <div class="marquee-fade marquee-fade-right"></div>

    <div class="marquee-track">
      {
        [...logos, ...logos, ...logos].map((logo, i) => (
          <div class="marquee-item">
            <img
              src={`/loop-icon/${logo}`}
              alt={`Client ${i}`}
              loading="lazy"
              decoding="async"
              width="80"
              height="80"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ==================================================================
     SECTION
     ================================================================== */
  .trusted-section {
    position: relative;
    z-index: 10;
    padding: 2rem 0 2.5rem;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 1024px) {
    .trusted-section {
      padding: 3rem 0 3.5rem;
    }
  }

  /* ==================================================================
     HEADER
     ================================================================== */
  .trusted-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1024px) {
    .trusted-header {
      margin-bottom: 2rem;
    }
  }

  .trusted-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: 0.25rem;
  }
  @media (min-width: 1024px) {
    .trusted-label {
      font-size: 0.75rem;
    }
  }

  .trusted-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 1024px) {
    .trusted-sub {
      font-size: 0.85rem;
    }
  }

  /* ==================================================================
     MARQUEE
     ================================================================== */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3rem;
    z-index: 2;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .marquee-fade {
      width: 8rem;
    }
  }
  .marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, rgb(10, 10, 10) 0%, transparent 100%);
  }
  .marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, rgb(10, 10, 10) 0%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    animation: marquee 40s linear infinite;
  }
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }
  @media (min-width: 1024px) {
    .marquee-track {
      gap: 3rem;
    }
  }

  /* ==================================================================
     ITEMS
     ================================================================== */
  .marquee-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
  }
  @media (min-width: 640px) {
    .marquee-item {
      width: 5rem;
      height: 5rem;
    }
  }
  @media (min-width: 1024px) {
    .marquee-item {
      width: 4.5rem;
      height: 4.5rem;
    }
  }

  .marquee-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1) brightness(0.7);
    opacity: 0.4;
    transition: all 0.3s ease;
  }
  .marquee-item:hover img {
    filter: grayscale(0) brightness(1);
    opacity: 1;
  }

  /* ==================================================================
     ANIMATION
     ================================================================== */
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333333%);
    }
  }
  /* ==================================================================
     STATS GRID
     ================================================================== */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-bottom: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    overflow: hidden;
    max-width: 480px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .stats-grid {
      max-width: 560px;
      margin-bottom: 2.5rem;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    position: relative;
  }
  /* Divider between the two columns */
  .stat-item:first-child {
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stat-value {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    line-height: 1;
  }

  .stat-number,
  .stat-suffix {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(
      135deg,
      #fff 30%,
      rgba(255, 255, 255, 0.5) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .stat-number,
    .stat-suffix {
      font-size: 2rem;
    }
  }

  .stat-label {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
  }
  @media (min-width: 1024px) {
    .stat-label {
      font-size: 0.6rem;
    }
  }
</style>

<script>
  function animateCountUp(
    el: HTMLElement,
    from: number,
    to: number,
    duration: number = 1800,
    pad: number = 0,
    format: boolean = false,
  ) {
    const startTime = performance.now();
    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(from + (to - from) * eased);
      if (format) {
        el.textContent = current.toLocaleString("id-ID");
      } else if (pad > 0) {
        el.textContent = String(current).padStart(pad, "0");
      } else {
        el.textContent = String(current);
      }
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const elInstansi = document.getElementById("stat-instansi") as HTMLElement;
    const elKemeja = document.getElementById("stat-kemeja") as HTMLElement;
    const statsGrid = document.querySelector(".stats-grid");

    if (!elInstansi || !elKemeja) return;

    let hasAnimated = false;

    const startAnimations = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      // INSTANSI: from 099 to 140 (zero-padded to 3 digits)
      animateCountUp(elInstansi, 99, 140, 3000, 3);

      // KEMEJA TERJUAL: from 5.000 to 10.240, then +1 every 5s
      let kemejaCount = 10240;
      animateCountUp(elKemeja, 5000, kemejaCount, 3800, 0, true);
      setInterval(() => {
        kemejaCount += 1;
        elKemeja.textContent = kemejaCount.toLocaleString("id-ID");
      }, 5000);
    };

    if (statsGrid && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            startAnimations();
            observer.disconnect();
          }
        });
      }, {
        threshold: 0.15
      });
      observer.observe(statsGrid);
    } else {
      // Fallback
      startAnimations();
    }
  });
</script>
