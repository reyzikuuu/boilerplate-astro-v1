---
// =============================================================================
// OFFER SECTION — Penawaran Terbatas + Diskon Card
// =============================================================================
import { getWhatsAppUrl } from "@data/siteConfig";

const benefits = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>`,
    title: "Kualitas Terjamin",
    desc: "Material premium, jahitan rapi, dan QC berstandar industri",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>`,
    title: "Pengiriman Tepat Waktu",
    desc: "Lead time jelas, pengiriman aman dan terjadwal",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>`,
    title: "Desain Kustom",
    desc: "Disesuaikan identitas brand dan kebutuhan operasional",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" /></svg>`,
    title: "Nyaman Dipakai",
    desc: "Breathable, anti-gerah, dan mudah perawatan",
  },
];
---

<section class="offer-section" id="penawaran">
  <div class="container-page">
    <div class="offer-layout">

      {/* LEFT — Penawaran Info */}
      <div class="offer-left">
        <div class="offer-left-header">
          <div class="offer-title-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
            </svg>
          </div>
          <h2 class="offer-title">Penawaran Terbatas</h2>
        </div>

        <p class="offer-desc">
          Nikmati harga khusus untuk pemesanan seragam <strong>korporat, industri, hospitality,</strong> dan <strong>organisasi.</strong>
          Tersedia opsi desain kustom, material premium, dan standar produksi yang terjamin.
        </p>

        {/* Benefits 2×2 grid */}
        <div class="offer-benefits">
          {benefits.map((item) => (
            <div class="benefit-item">
              <div class="benefit-icon" set:html={item.icon} />
              <div class="benefit-content">
                <p class="benefit-title">{item.title}</p>
                <p class="benefit-desc">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        {/* CTA */}
        <a
          href={getWhatsAppUrl("Halo Bradwear, saya tertarik dengan penawaran terbatas.")}
          target="_blank"
          rel="noopener noreferrer"
          id="offer-whatsapp-cta"
          class="offer-cta group"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Order Via WhatsApp</span>
          <div class="absolute top-0 -inset-full h-full w-1/2 z-5 block transform -skew-x-12 bg-linear-to-r from-transparent via-white/25 to-transparent group-hover:animate-[shine_0.6s_ease-out]"></div>
        </a>
      </div>

      {/* RIGHT — Diskon Card */}
      <div class="offer-right">
        <span class="discount-badge">Diskon Spesial</span>
        <p class="discount-headline">
          Diskon Hingga <span class="discount-number">20%</span>
        </p>
        <p class="discount-desc">
          Untuk paket korporat dan organisasi tertentu*
        </p>
        <p class="discount-terms">
          *Syarat dan ketentuan berlaku. Hubungi CS untuk detail.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  /* ==================================================================
     SECTION
     ================================================================== */
  .offer-section {
    position: relative;
    z-index: 10;
    padding: 4rem 0 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  @media (min-width: 1024px) {
    .offer-section {
      padding: 6rem 0 7rem;
    }
  }

  /* ==================================================================
     LAYOUT — stacked on mobile, side-by-side on desktop
     ================================================================== */
  .offer-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .offer-layout {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  /* ==================================================================
     LEFT CARD
     ================================================================== */
  .offer-left {
    flex: 1;
    padding: 1.75rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 1024px) {
    .offer-left {
      padding: 2.25rem;
    }
  }

  .offer-left-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .offer-title-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-gold);
    flex-shrink: 0;
  }
  .offer-title-icon svg {
    width: 100%;
    height: 100%;
  }

  .offer-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    .offer-title {
      font-size: 1.4rem;
    }
  }

  .offer-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .offer-desc strong {
    color: rgba(255, 255, 255, 0.7);
  }
  @media (min-width: 1024px) {
    .offer-desc {
      font-size: 0.85rem;
    }
  }

  /* ==================================================================
     BENEFITS GRID
     ================================================================== */
  .offer-benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  @media (min-width: 480px) {
    .offer-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .benefit-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: var(--color-gold);
    margin-top: 0.1rem;
  }
  .benefit-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .benefit-content {
    flex: 1;
    min-width: 0;
  }

  .benefit-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.15rem;
    line-height: 1.3;
  }

  .benefit-desc {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.45;
  }
  @media (min-width: 1024px) {
    .benefit-title {
      font-size: 0.85rem;
    }
    .benefit-desc {
      font-size: 0.75rem;
    }
  }

  /* ==================================================================
     CTA BUTTON
     ================================================================== */
  .offer-cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 50%, #25d366 100%);
    background-size: 200% 200%;
    box-shadow:
      0 0 20px rgba(37, 211, 102, 0.2),
      0 4px 12px rgba(37, 211, 102, 0.15);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background-position 0.5s ease;
    cursor: pointer;
  }
  .offer-cta:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 0 30px rgba(37, 211, 102, 0.35),
      0 8px 20px rgba(37, 211, 102, 0.2);
    background-position: 100% 100%;
  }
  .offer-cta:active {
    transform: translateY(0) scale(0.98);
  }

  /* ==================================================================
     RIGHT — DISCOUNT CARD
     ================================================================== */
  .offer-right {
    flex-shrink: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.75rem;
    border-radius: 1.25rem;
    background: linear-gradient(145deg, rgba(245, 158, 11, 0.12) 0%, rgba(245, 158, 11, 0.04) 100%);
    border: 1px solid rgba(245, 158, 11, 0.18);
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .offer-right {
      width: 280px;
      padding: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .offer-right {
      width: 320px;
    }
  }

  /* Subtle shimmer glow on the discount card */
  .offer-right::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .discount-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold);
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.25);
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1024px) {
    .discount-badge {
      font-size: 0.65rem;
    }
  }

  .discount-headline {
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1024px) {
    .discount-headline {
      font-size: 2rem;
    }
  }

  .discount-number {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 2.5rem;
    display: block;
    letter-spacing: -0.03em;
  }
  @media (min-width: 1024px) {
    .discount-number {
      font-size: 3.25rem;
    }
  }

  .discount-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1024px) {
    .discount-desc {
      font-size: 0.85rem;
    }
  }

  .discount-terms {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1.5;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1024px) {
    .discount-terms {
      font-size: 0.68rem;
    }
  }
</style>
