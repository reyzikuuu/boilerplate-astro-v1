---
// =============================================================================
// HOMEPAGE — Landing Page Bradwear
// =============================================================================
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import TrustedBy from "@components/sections/TrustedBy.astro";
import PainPoint from "@components/sections/PainPoint.astro";
import WhyUs from "@components/sections/WhyUs.astro";
import Gallery from "@components/sections/Gallery.astro";
import Offer from "@components/sections/Offer.astro";
import Faq from "@components/sections/Faq.astro";
import { siteConfig } from "@data/siteConfig";

export const prerender = true;
---

<BaseLayout
  title="Pabrik Seragam Instansi & Korporat Terpercaya di Indonesia"
  description={siteConfig.description}
  schemaType="website"
>
  {
    /* ================================================================
      BACKGROUND LAYER
      ================================================================ */
  }
  <div class="fixed inset-0 -z-10 bg-neutral-950 overflow-hidden">
    {/* Layer 1: Aurora Glows */}
    <div
      class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[rgba(120,119,198,0.15)] blur-[120px] animate-blob"
    >
    </div>
    <div
      class="absolute top-[20%] right-[-10%] w-[40%] h-[40%] rounded-full bg-[rgba(120,119,198,0.1)] blur-[120px] animate-blob"
      style="animation-delay: 2s;"
    >
    </div>
    <div
      class="absolute bottom-[-20%] left-[20%] w-[50%] h-[50%] rounded-full bg-[rgba(120,119,198,0.12)] blur-[120px] animate-blob"
      style="animation-delay: 4s;"
    >
    </div>

    {/* Layer 1.5: Grainy Noise Overlay */}
    <div
      class="absolute inset-0 opacity-[0.25] mix-blend-overlay pointer-events-none"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;);"
    >
    </div>

    {/* Layer 2: Animated Grid with Ellipse Masking */}
    <div
      class="absolute inset-0 bg-grid-white"
      style="mask-image: radial-gradient(ellipse 42% 42% at 50% 50%, black 20%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 42% 42% at 50% 50%, black 20%, transparent 100%);"
    >
    </div>
  </div>

  {
    /* ================================================================
      HERO SECTION
      ================================================================ */
  }
  <Hero />

  {
    /* ================================================================
      TRUSTED BY SECTION (Logos Loop)
      ================================================================ */
  }
  <TrustedBy />

  {
    /* ================================================================
      PAIN POINT SECTION
      ================================================================ */
  }
  <PainPoint />

  {
    /* ================================================================
      WHY US SECTION — Keunggulan Bradwear
      ================================================================ */
  }
  <WhyUs />

  {
    /* ================================================================
      GALLERY SECTION — Produk Slider
      ================================================================ */
  }
  <Gallery />

  {
    /* ================================================================
      OFFER SECTION — Penawaran Terbatas
      ================================================================ */
  }
  <Offer />

  {
    /* ================================================================
      FAQ SECTION
      ================================================================ */
  }
  <Faq />
</BaseLayout>

<style is:global>
  /* Styling untuk Grid Pattern */
  .bg-grid-white {
    background-size: 35px 35px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    animation: grid-move-up 3s linear infinite;
  }

  @keyframes grid-move-up {
    0% {
      background-position: 0 35px;
    }
    100% {
      background-position: 0 0;
    }
  }

  /* Animasi untuk Aurora Blobs */
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  .animate-blob {
    animation: blob 10s infinite alternate ease-in-out;
  }
</style>
