---
// =============================================================================
// KATALOG — Halaman Listing Semua Produk
// =============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductCard from '@components/catalog/ProductCard.astro';
import { getAllProducts } from '@data/products';
import { siteConfig } from '@data/siteConfig';

export const prerender = true;

const products = getAllProducts();
---

<BaseLayout
  title="Katalog Produk — Seragam Custom Premium"
  description={`Jelajahi koleksi ${siteConfig.name}: kemeja PDH, tactical, wearpack, dan seragam custom lainnya. Material premium, bordir 3D, gratis desain.`}
  schemaType="website"
>
  <section class="catalog-section">
    <div class="container-page">
      <!-- Header -->
      <div class="catalog-header">
        <p class="catalog-eyebrow">KATALOG PRODUK</p>
        <h1 class="catalog-headline">
          Koleksi <span class="text-gradient">Bradwear</span>
        </h1>
        <p class="catalog-subtitle">
          Temukan seragam custom premium yang tepat untuk instansi, korporat, dan organisasi Anda.
          Semua produk tersedia dengan pilihan bahan dan ukuran yang lengkap.
        </p>
      </div>

      <!-- Product Grid -->
      <div class="catalog-grid">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="catalog-bottom-cta">
        <p class="bottom-cta-text">
          Tidak menemukan produk yang Anda cari? Kami bisa membuatnya!
        </p>
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Halo Bradwear, saya ingin konsultasi mengenai produk custom.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bottom-cta-button group"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Konsultasi Produk Custom</span>
          <div class="absolute top-0 -inset-full h-full w-1/2 z-5 block transform -skew-x-12 bg-linear-to-r from-transparent via-white/25 to-transparent group-hover:animate-[shine_0.6s_ease-out]"></div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================================================================
     SECTION
     ================================================================ */
  .catalog-section {
    position: relative;
    z-index: 10;
    padding: 7rem 0 5rem;
  }
  @media (min-width: 1024px) {
    .catalog-section {
      padding: 8rem 0 7rem;
    }
  }

  /* ================================================================
     HEADER
     ================================================================ */
  .catalog-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  @media (min-width: 1024px) {
    .catalog-header {
      margin-bottom: 4rem;
    }
  }

  .catalog-eyebrow {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 1024px) {
    .catalog-eyebrow {
      font-size: 0.7rem;
    }
  }

  .catalog-headline {
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  @media (min-width: 640px) {
    .catalog-headline {
      font-size: 2.25rem;
    }
  }
  @media (min-width: 1024px) {
    .catalog-headline {
      font-size: 2.75rem;
    }
  }

  .catalog-subtitle {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.65;
    max-width: 540px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .catalog-subtitle {
      font-size: 0.95rem;
    }
  }

  /* ================================================================
     PRODUCT GRID
     ================================================================ */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .catalog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .catalog-grid {
      gap: 1.5rem;
    }
  }

  /* ================================================================
     BOTTOM CTA
     ================================================================ */
  .catalog-bottom-cta {
    margin-top: 3.5rem;
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 1024px) {
    .catalog-bottom-cta {
      margin-top: 4.5rem;
      padding: 2.5rem 2rem;
    }
  }

  .bottom-cta-text {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.25rem;
  }
  @media (min-width: 1024px) {
    .bottom-cta-text {
      font-size: 0.95rem;
    }
  }

  .bottom-cta-button {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 50%, #25d366 100%);
    background-size: 200% 200%;
    box-shadow:
      0 0 20px rgba(37, 211, 102, 0.2),
      0 4px 12px rgba(37, 211, 102, 0.15);
    transition: transform 0.3s ease,
                box-shadow 0.3s ease,
                background-position 0.5s ease;
    cursor: pointer;
  }
  .bottom-cta-button:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 0 30px rgba(37, 211, 102, 0.35),
      0 8px 20px rgba(37, 211, 102, 0.2);
    background-position: 100% 100%;
  }
  .bottom-cta-button:active {
    transform: translateY(0) scale(0.98);
  }
</style>
