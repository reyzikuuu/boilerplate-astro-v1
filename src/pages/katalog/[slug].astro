---
// =============================================================================
// DETAIL PRODUK — Halaman Detail Per Produk
// =============================================================================
// Dynamic route: /katalog/[slug]
// Prerendered secara statis via getStaticPaths()
// =============================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductGallery from '@components/catalog/ProductGallery.astro';
import MaterialSelector from '@components/catalog/MaterialSelector.astro';
import SizeChart from '@components/catalog/SizeChart.astro';
import { getAllProducts, getProductBySlug } from '@data/products';
import { siteConfig } from '@data/siteConfig';

export const prerender = true;

export function getStaticPaths() {
  const products = getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug!);

if (!product) {
  return Astro.redirect('/404');
}

const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(product.whatsappMessage)}`;
---

<BaseLayout
  title={`${product.name} — ${siteConfig.name}`}
  description={product.shortDescription}
  schemaType="landing-page"
>
  <section class="detail-section">
    <div class="container-page">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="detail-breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/katalog">Katalog</a></li>
          <li aria-hidden="true">/</li>
          <li class="current">{product.name}</li>
        </ol>
      </nav>

      <!-- ================================================================
           TOP SECTION — Galeri + Info Utama (2-kolom desktop)
           ================================================================ -->
      <div class="detail-top">
        <!-- Kolom Kiri: Galeri Gambar -->
        <div class="detail-gallery-col">
          <ProductGallery images={product.images} productName={product.name} />
        </div>

        <!-- Kolom Kanan: Info Produk -->
        <div class="detail-info-col">
          <!-- Nama Produk -->
          <h1 class="detail-name">{product.name}</h1>

          <!-- Deskripsi Singkat -->
          <p class="detail-short-desc">{product.shortDescription}</p>

          <!-- Tags / Quick Info -->
          <div class="detail-tags">
            <span class="detail-tag">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
              </svg>
              {product.materials.length} Pilihan Bahan
            </span>
            <span class="detail-tag">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
              </svg>
              {product.sizes.length} Ukuran
            </span>
            <span class="detail-tag">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
              </svg>
              Custom Desain
            </span>
          </div>

          <!-- Divider -->
          <div class="detail-divider"></div>

          <!-- CTA Button -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            id={`cta-${product.slug}`}
            class="detail-cta group"
          >
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <div class="cta-text-group">
              <span class="cta-main-text">Tanya Gratis!</span>
              <span class="cta-sub-text">Respon cepat via WhatsApp</span>
            </div>
            <!-- Shimmer effect -->
            <div class="absolute top-0 -inset-full h-full w-1/2 z-5 block transform -skew-x-12 bg-linear-to-r from-transparent via-white/20 to-transparent animate-shine"></div>
          </a>

          <!-- Trust indicator -->
          <div class="detail-trust">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.765 11.765 0 0 1 3.09 9.338a11.79 11.79 0 0 0 8.91 10.912 11.79 11.79 0 0 0 8.91-10.912A11.765 11.765 0 0 0 12 2.714Z" />
            </svg>
            <span>Gratis konsultasi • Tanpa komitmen</span>
          </div>
        </div>
      </div>

      <!-- ================================================================
           BOTTOM SECTIONS — Bahan, Deskripsi, Size Chart
           ================================================================ -->
      <div class="detail-bottom">

        <!-- Section: Pilihan Bahan -->
        <div class="detail-card" id="pilihan-bahan">
          <MaterialSelector materials={product.materials} />
        </div>

        <!-- Section: Deskripsi Produk -->
        <div class="detail-card" id="deskripsi">
          <div class="desc-header">
            <svg class="desc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
            <h2 class="desc-title">Deskripsi Produk</h2>
          </div>

          <p class="desc-text">{product.description}</p>

          <div class="desc-features">
            <p class="desc-features-title">Fitur Unggulan:</p>
            <ul class="desc-features-list">
              {product.features.map((feature) => (
                <li>
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Section: Size Chart -->
        <div class="detail-card" id="size-chart">
          <SizeChart
            sizes={product.sizes}
            sizeChartImage={product.sizeChartImage}
            productName={product.name}
          />
        </div>

      </div>

      <!-- Back to Catalog -->
      <div class="detail-back">
        <a href="/katalog" class="back-link">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Kembali ke Katalog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Track Lead saat klik CTA WhatsApp -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctaButtons = document.querySelectorAll('[id^="cta-"]');
    ctaButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (typeof window.trackMetaEvent === 'function') {
          window.trackMetaEvent('Lead', {
            content_name: `WhatsApp CTA — ${document.title}`,
            content_category: 'Product Detail',
          });
        }
      });
    });
  });
</script>

<style>
  /* ================================================================
     SECTION
     ================================================================ */
  .detail-section {
    position: relative;
    z-index: 10;
    padding: 6.5rem 0 4rem;
  }
  @media (min-width: 1024px) {
    .detail-section {
      padding: 7.5rem 0 6rem;
    }
  }

  /* ================================================================
     BREADCRUMB
     ================================================================ */
  .detail-breadcrumb {
    margin-bottom: 2rem;
  }
  .detail-breadcrumb ol {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.35);
  }
  .detail-breadcrumb a {
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.2s ease;
  }
  .detail-breadcrumb a:hover {
    color: var(--color-gold);
  }
  .detail-breadcrumb .current {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .detail-breadcrumb ol {
      font-size: 0.78rem;
    }
  }

  /* ================================================================
     TOP — 2-Column Layout
     ================================================================ */
  .detail-top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .detail-top {
      flex-direction: row;
      gap: 2.5rem;
      margin-bottom: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .detail-top {
      gap: 3rem;
    }
  }

  /* Gallery column */
  .detail-gallery-col {
    width: 100%;
  }
  @media (min-width: 768px) {
    .detail-gallery-col {
      width: 45%;
      flex-shrink: 0;
    }
  }
  @media (min-width: 1024px) {
    .detail-gallery-col {
      width: 42%;
    }
  }

  /* Info column */
  .detail-info-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .detail-info-col {
      padding-top: 0.5rem;
    }
  }

  /* ================================================================
     PRODUCT NAME
     ================================================================ */
  .detail-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 640px) {
    .detail-name {
      font-size: 1.75rem;
    }
  }
  @media (min-width: 1024px) {
    .detail-name {
      font-size: 2rem;
    }
  }

  /* ================================================================
     SHORT DESCRIPTION
     ================================================================ */
  .detail-short-desc {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  @media (min-width: 1024px) {
    .detail-short-desc {
      font-size: 0.9rem;
    }
  }

  /* ================================================================
     TAGS
     ================================================================ */
  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .detail-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .detail-tag svg {
    color: var(--color-gold);
  }
  @media (min-width: 1024px) {
    .detail-tag {
      font-size: 0.72rem;
    }
  }

  /* ================================================================
     DIVIDER
     ================================================================ */
  .detail-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin-bottom: 1.5rem;
  }

  /* ================================================================
     CTA BUTTON
     ================================================================ */
  .detail-cta {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem 1.5rem;
    border-radius: 0.85rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, #25d366 0%, #128c7e 50%, #25d366 100%);
    background-size: 200% 200%;
    box-shadow:
      0 0 25px rgba(37, 211, 102, 0.25),
      0 6px 15px rgba(37, 211, 102, 0.18);
    transition: transform 0.3s ease,
                box-shadow 0.3s ease,
                background-position 0.5s ease;
    cursor: pointer;
    margin-bottom: 0.75rem;
  }
  .detail-cta:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow:
      0 0 35px rgba(37, 211, 102, 0.4),
      0 10px 25px rgba(37, 211, 102, 0.22);
    background-position: 100% 100%;
  }
  .detail-cta:active {
    transform: translateY(0) scale(0.98);
  }

  .cta-text-group {
    display: flex;
    flex-direction: column;
  }
  .cta-main-text {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .cta-sub-text {
    font-size: 0.68rem;
    font-weight: 500;
    opacity: 0.75;
    line-height: 1.3;
  }

  /* ================================================================
     TRUST INDICATOR
     ================================================================ */
  .detail-trust {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
  }
  .detail-trust svg {
    color: var(--color-success);
  }
  @media (min-width: 1024px) {
    .detail-trust {
      font-size: 0.75rem;
    }
  }

  /* ================================================================
     BOTTOM SECTIONS
     ================================================================ */
  .detail-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .detail-bottom {
      gap: 2rem;
    }
  }

  .detail-card {
    padding: 1.5rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 1024px) {
    .detail-card {
      padding: 2rem;
    }
  }

  /* ================================================================
     DESCRIPTION SECTION
     ================================================================ */
  .desc-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .desc-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .desc-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }
  @media (min-width: 1024px) {
    .desc-title {
      font-size: 1.15rem;
    }
  }

  .desc-text {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1024px) {
    .desc-text {
      font-size: 0.88rem;
    }
  }

  .desc-features-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.75rem;
  }
  @media (min-width: 1024px) {
    .desc-features-title {
      font-size: 0.85rem;
    }
  }

  .desc-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .desc-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
  }
  .desc-features-list svg {
    color: var(--color-success);
    margin-top: 0.05rem;
  }
  @media (min-width: 1024px) {
    .desc-features-list li {
      font-size: 0.82rem;
    }
  }

  /* ================================================================
     BACK TO CATALOG
     ================================================================ */
  .detail-back {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s ease, gap 0.3s ease;
  }
  .back-link:hover {
    color: var(--color-gold);
    gap: 0.6rem;
  }
  @media (min-width: 1024px) {
    .back-link {
      font-size: 0.85rem;
    }
  }
</style>
